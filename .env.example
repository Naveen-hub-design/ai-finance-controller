# Copy this file to .env before starting the stack:
#   cp .env.example .env
# Never commit the real .env file.

# --- PostgreSQL 16 (pgvector-enabled image) ---
POSTGRES_DB=finance_controller
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=change-me-strong-local-password
POSTGRES_PORT=5432

# --- Redis 7 ---
REDIS_PORT=6379

# --- Flask ---
# Required in any real deployment. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate-a-long-random-value

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
